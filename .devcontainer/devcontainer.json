{
  "image": "mcr.microsoft.com/dotnet/sdk:9.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.blazorwasm-companion",
        "ms-vscode.vscode-json",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.test-adapter-converter",
        "humao.rest-client",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  },
  "postCreateCommand": "chmod +x .devcontainer/init.sh && .devcontainer/init.sh",
  "postStartCommand": "nohup dotnet run --project TodoApp.AppHost > aspire.log 2>&1 &",
  "forwardPorts": [
    5000,
    5001,
    5147,
    7123,
    15169,
    17249
  ],
  "portsAttributes": {
    "5000": {
      "label": "Todo API (HTTP)",
      "onAutoForward": "openBrowser"
    },
    "5001": {
      "label": "Todo API (HTTPS)",
      "onAutoForward": "openBrowser"
    },
    "5147": {
      "label": "Todo Web App (HTTP)",
      "onAutoForward": "openBrowser"
    },
    "7123": {
      "label": "Todo Web App (HTTPS)",
      "onAutoForward": "openBrowser"
    },
    "15169": {
      "label": "Aspire Dashboard (HTTP)",
      "onAutoForward": "openBrowser"
    },
    "17249": {
      "label": "Aspire Dashboard (HTTPS)",
      "onAutoForward": "openBrowser"
    }
  }
}